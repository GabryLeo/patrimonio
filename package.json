{
  "name": "patrimonio",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=@patrimonio/api && npm run build --workspace=@patrimonio/web",
    "lint": "npm run lint --workspace=@patrimonio/web",
    "db:generate": "npm run db:generate --workspace=@patrimonio/api",
    "db:migrate": "npm run db:migrate --workspace=@patrimonio/api"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
